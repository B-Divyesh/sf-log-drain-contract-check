{
  "name": "drain-check-site",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:site",
    "generate:sample": "cargo run --quiet -- inspect examples/drain.ndjson --sample-seconds 600 --output site/src/sample-report.json",
    "build:site": "npm run generate:sample && vite build --outDir dist/site && cp staticwebapp.config.json dist/site/staticwebapp.config.json",
    "test": "vitest run site/e2e.test.ts --exclude 'target/**'",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --outDir dist/site"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/node": "22.18.3",
    "jsdom": "26.1.0",
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
